<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Whisper large-v3-turbo on iPhone is a 1.6 GB fp16 graph (3.2 GB AOT bundle); loading it
	     past the default jetsam limit needs the increased memory limit, same as the chat ports. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
