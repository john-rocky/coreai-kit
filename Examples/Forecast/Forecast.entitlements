<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TimesFM 2.5's graph is compiled on the phone when it loads. Without the increased memory limit an
	     iPhone 18 Pro run aborted inside that compile (an allocation failed in MPSGraph). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
